# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for the AI Search (Dora Assistant) feature.
# Must have access to gpt-4o.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Add any other environment variables your lib/appConfig.ts reads ──────────
# e.g. Typesense host, API key, collection name if loaded from env

# ─── Bunny CDN (only for scripts/upload-bunny.mjs, not read by the app) ────────
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_UPLOAD_URL=https://ny.storage.bunnycdn.com
BUNNY_CDN_URL=https://phaeton.b-cdn.net
